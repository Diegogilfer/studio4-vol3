# ==============================================================================
# STUDIO 4 Vol. 3 - Variables de Entorno
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ECOSISTEMA GOOGLE (Principal para hoy)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Guionista Creativo + Director Técnico)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Cloud Text-to-Speech (Voz en off comercial)
# Opción A (Recomendada): Archivo JSON de cuenta de servicio de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Opción B (Alternativa): API Key de Google Cloud con Text-to-Speech API habilitada
# (Si no se especifica, intentará usar GEMINI_API_KEY si tiene permisos de Cloud TTS)
# GOOGLE_CLOUD_API_KEY=

# ------------------------------------------------------------------------------
# 2. METRAJE Y STOCK AUDIOVISUAL
# ------------------------------------------------------------------------------
# Pexels API Key (Descarga de clips B-roll HD)
# Gratuita en: https://www.pexels.com/api/
PEXELS_API_KEY=

# ------------------------------------------------------------------------------
# 3. ANTHROPIC CLAUDE (Opcional - Ranura lista para cuando se use)
# ------------------------------------------------------------------------------
# Anthropic API Key (Activar con: python main.py "Tema" --writer claude)
# ANTHROPIC_API_KEY=
