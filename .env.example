# ==============================================================================
# STUDIO #4 Vol. 3 · Todo con Google (gratis + tu suscripción)
# ==============================================================================

# Gemini (AI Studio, nivel gratis): guion, plan de escenas y voz.
# Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Voz de Gemini TTS (Charon, Kore, Puck, Aoede, Fenrir, Leda, Orus, Zephyr...)
GEMINI_TTS_VOICE=Charon
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_ESTILO=Narra en español neutro, como un documental intrigante

# DeepSeek (de pago por uso, céntimos por guion): escribe los guiones.
# https://platform.deepseek.com › API keys. Sin clave, los escribe Gemini.
DEEPSEEK_API_KEY=
# Imágenes y vídeo de pago por fal.ai (con saldo; sin facturación de Google): fal.ai/dashboard/keys
FAL_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash   (o deepseek-v4-pro)

# YouTube en solo lectura (Google Cloud › APIs › YouTube Data API v3 › Credenciales › Clave de API).
# Con la clave: lo que ya existe sobre cada tema y los datos públicos de tu canal. STUDIO no publica.
YOUTUBE_API_KEY=
YOUTUBE_CANAL=   # @usuario de tu canal

# Google Flow (tu suscripción): no lleva clave. La extensión se vincula con este código,
# que se genera solo al arrancar y se renueva con «Nueva vinculación» en el panel.
STUDIO4_FLOW_TOKEN=

# ElevenLabs (opcional). Plan gratis: 10.000 créditos/mes, hay que citar a ElevenLabs
# y NO permite uso comercial (vídeos monetizados → plan Starter o Gemini TTS).
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Volumen del sonido ambiente de Veo bajo la voz (0 = sin sonido de Veo)
# STUDIO4_VOLUMEN_AMBIENTE=0.15
